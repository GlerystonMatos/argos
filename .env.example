# Copie para .env (gitignored) e preencha os valores reais. O docker-compose
# lê o .env da raiz automaticamente.

# Senha do certificado usado em ./certificado/certificado.pfx (serviço argos_api).
KESTREL_CERTIFICATE_PASSWORD=

# Autenticação HTTP Basic da Api — opcional. Deixe as duas em branco pra
# manter a Api sem autenticação (padrão, uso local). Preenchendo as duas,
# a Api passa a exigir login (tela própria no frontend, ver CLAUDE.md §4.8).
AUTH__USUARIO=
AUTH__SENHA=

# Chave usada para criptografar os tokens salvos nos dados —
# opcional. Sem ela, os tokens ainda são criptografados, só que com uma
# chave padrão embutida no código-fonte (proteção mínima).
CHAVE_CRIPTOGRAFIA=

# Projeto GCP do Firestore (Argos.Armazenamento) — opcional. Vazia = a Api grava
# dados/*.json. O docker-compose não repassa esta variável (o container usa
# dados/); ela serve para rodar a Api fora do Docker ou no Cloud Run.
ARMAZENAMENTO__PROJETO_FIRESTORE=